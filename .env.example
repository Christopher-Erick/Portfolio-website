# =============================================================================
# CLOUDFLARE DEPLOYMENT & SECURITY ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual production credentials.
# NEVER commit the actual .env file to version control!

# Core Application Settings
DEBUG=False
SECRET_KEY=generate-a-secure-50-character-secret-key-here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://*.trycloudflare.com

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=eyJh...YourCloudflareTunnelToken...
CLOUDFLARE_TUNNEL_ID=your-tunnel-uuid-here
DOMAIN_NAME=yourdomain.com

# Cloudflare R2 Object Storage (Zero Egress Fees Media Hosting)
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=portfolio-media
CLOUDFLARE_R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.yourdomain.com

# Database Configuration (PostgreSQL in production)
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=generate-strong-db-password
POSTGRES_DB=portfolio_db
DATABASE_URL=postgres://portfolio_user:generate-strong-db-password@db:5432/portfolio_db

# Security & Admin Custom Path
ADMIN_URL=secure-admin-ceo789/
ADMIN_USERNAME=admin
ADMIN_EMAIL=christophererick879@gmail.com

# Email Gateway Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
CONTACT_EMAIL=your-email@gmail.com

# Personal Info
FULL_NAME=Christopher Erick Otieno
EMAIL=christophererick879@gmail.com
PHONE=+254758081580
LOCATION=Nairobi, Kenya

# Security Enforcement Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True